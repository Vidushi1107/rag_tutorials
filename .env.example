# Copy this file to .env and fill in your key.
#   cp .env.example .env

# Required for every module. Used for both chat completions and embeddings.
OPENAI_API_KEY=sk-your-key-here

# Optional. Only needed by specific modules; each module's README says if it applies.
# COHERE_API_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
